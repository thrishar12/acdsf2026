# ============================================================
# ACDSF Backend — Environment Variables Template
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=4bf994e4d1ec26aefb21374838ef7633cdfa99f68cb7bbfa70d8b021dea5948c
JWT_EXPIRY_HOURS=1
REFRESH_TOKEN_SECRET=acdsf_refresh_b9d3e7a2c4f15082e6d941bc37a05f81
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=false
# Allowed frontend origin (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# ── SMTP Email Notifications ─────────────────────────────────
# Google Gmail: requires a 16-character Google App Password (not your normal Gmail password)
# Setup: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=myacdsfproject@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_NAME=ACDSF SOC Command

# ── SMS Gateway Configuration (Indian Mobile Numbers) ────────
# Option 1: Fast2SMS (Recommended for Indian numbers: +91)
# Sign up at: https://www.fast2sms.com/ -> Dev API -> Get API Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio SMS Gateway
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Option 3: Generic SMS Gateway Webhook
# SMS_GATEWAY_URL=https://api.sms-provider.com/send
# SMS_API_KEY=your_sms_api_key

# ── Database ─────────────────────────────────────────────────
# Path is relative to acdsf-backend/
DB_PATH=digital_twin.db

# ── Rate Limiting ────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
